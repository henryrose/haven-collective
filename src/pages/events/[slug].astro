---
import { Image } from 'astro:assets';
import { getCollection, getEntries, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDateRange, formatLongDate, getEventsChronological, isUpcoming } from '../../lib/events';

export async function getStaticPaths() {
  const events = await getEventsChronological();
  return events.map((event, i) => ({
    params: { slug: event.id },
    props: { event, earlier: events[i - 1], later: events[i + 1] },
  }));
}

const { event, earlier, later } = Astro.props;
const data = event.data;
const upcoming = isUpcoming(event);
const { Content } = await render(event);
const artists = (await getEntries(data.artists)).sort((a, b) => a.data.order - b.data.order);

const dateLine = upcoming
  ? `Opens ${formatLongDate(data.startDate)}`
  : formatDateRange(data.startDate, data.endDate);
const badge = upcoming ? 'Upcoming show' : `Past show · ${formatDateRange(data.startDate, data.endDate, 'short')}`;
const showHero = !upcoming && data.hero;
const showGallery = !upcoming && data.photos.length > 0;
---

<Base title={data.title} description={`${data.title} · ${formatDateRange(data.startDate, data.endDate)} · ${data.venue}, ${data.address}`}>
  {
    showHero && (
      <section class="band">
        <Image src={data.hero!.image} alt="" widths={[640, 960, 1280, 1400]} sizes="100vw" priority style={`object-position: ${data.hero!.position}`} />
      </section>
    )
  }

  <section class="details">
    <div class="left">
      <a href="/events" class="meta back">← All events</a>
      <div class="label eyebrow" class:list={{ clay: upcoming, muted: !upcoming }}>
        <span class="dot" />
        {badge}
      </div>
      <h1>{data.title}</h1>
      <div class="date">{dateLine}</div>
      <dl class="facts">
        <dt class="meta">Venue</dt>
        <dd>
          {data.venue}
          <br />
          <span class="muted">{data.address}</span>
          {data.mapUrl && (
            <>
              {' · '}
              <a href={data.mapUrl} class="map" target="_blank" rel="noopener">
                Map
              </a>
            </>
          )}
        </dd>
        {
          data.reception && (
            <>
              <dt class="meta">Reception</dt>
              <dd>{data.reception}</dd>
            </>
          )
        }
      </dl>
      {
        (data.posterPdf || data.pressRelease || upcoming) && (
          <div class="buttons">
            {data.posterPdf && (
              <a href={data.posterPdf} class="button">
                Poster PDF
              </a>
            )}
            {data.pressRelease && (
              <a href={data.pressRelease} class="button">
                Press release
              </a>
            )}
            {upcoming && (
              <a href={`/events/${event.id}.ics`} class="button" download>
                Add to calendar
              </a>
            )}
          </div>
        )
      }
    </div>

    <div class="right">
      {
        upcoming && (
          <div class="poster-mat">
            {data.poster ? (
              <Image src={data.poster} alt={`${data.title} poster`} widths={[420, 840]} sizes="(min-width: 760px) 420px, 100vw" />
            ) : (
              <div class="placeholder poster-placeholder">show poster</div>
            )}
          </div>
        )
      }
      <div class="blurb">
        <Content />
      </div>
    </div>
  </section>

  {
    showGallery && (
      <section class="room">
        <h2 class="h2">In the room</h2>
        <div class="room-container">
          <div class="room-grid">
            {data.photos.map((p) => (
              <figure class:list={[p.emphasis]}>
                <Image src={p.image} alt={p.caption ?? ''} widths={[320, 640, 960]} sizes="(min-width: 760px) 33vw, 100vw" style={`object-position: ${p.position}`} />
                {p.caption && <figcaption>{p.caption}</figcaption>}
              </figure>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    artists.length > 0 && (
      <section class="artists">
        <h2 class="h2">Artists in this show</h2>
        <ul class="artist-grid">
          {artists.map((a) => (
            <li>
              <a href={`/artists/${a.id}`} class="artist">
                <div class="square">
                  {a.data.keyWork ? (
                    <Image src={a.data.keyWork} alt="" widths={[200, 400]} sizes="(min-width: 760px) 16vw, 50vw" style={`object-position: ${a.data.keyWorkPosition}`} />
                  ) : (
                    <div class="placeholder" />
                  )}
                </div>
                <div>
                  <div class="name">{a.data.name}</div>
                  <div class="meta medium">{a.data.medium}</div>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <nav class="prev-next" aria-label="Other events">
    {earlier ? <a href={`/events/${earlier.id}`}>← Previous: {earlier.data.title}</a> : <span />}
    {later && <a href={`/events/${later.id}`}>Next: {later.data.title} →</a>}
  </nav>
</Base>

<style>
  .band {
    height: clamp(260px, 42vh, 480px);
    overflow: hidden;
    border-bottom: 1px solid var(--hairline);
    background: var(--placeholder);
  }
  .band img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .details,
  .room,
  .artists {
    padding: clamp(36px, 5vw, 64px) var(--pad-x);
    border-bottom: 1px solid var(--hairline);
  }
  .details {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: clamp(28px, 5vw, 72px);
  }
  .left {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .back:hover {
    color: var(--clay);
  }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .eyebrow.clay {
    color: var(--clay);
  }
  .eyebrow.muted {
    color: var(--muted);
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: currentColor;
  }
  h1 {
    font-size: clamp(36px, 5.5vw, 64px);
    line-height: 0.96;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .date {
    font-size: clamp(18px, 2vw, 22px);
    line-height: 1.3;
  }
  .facts {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 8px 18px;
    margin: 10px 0 0;
    padding-top: 18px;
    border-top: 1px solid var(--hairline);
    font-size: 16px;
    line-height: 1.45;
  }
  .facts dt {
    padding-top: 4px;
  }
  .facts dd {
    margin: 0;
  }
  .muted {
    color: var(--muted);
  }
  .map {
    border-bottom: 1.5px solid var(--clay);
    padding-bottom: 1px;
  }
  .buttons {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 8px;
  }
  .buttons .button {
    padding: 9px 14px;
  }

  .right {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .poster-mat {
    aspect-ratio: 3 / 4;
    max-width: 420px;
    width: 100%;
    background: var(--paper);
    box-shadow: 0 18px 40px -24px rgba(43, 37, 33, 0.45);
    padding: 12px;
    position: relative;
  }
  .poster-mat img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .poster-placeholder {
    position: static;
    height: 100%;
    background: repeating-linear-gradient(45deg, var(--placeholder) 0 14px, var(--placeholder-stripe) 14px 28px);
    font-size: 13px;
    padding: 16px;
  }
  .blurb {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 600px;
    font-size: clamp(17px, 1.6vw, 20px);
    line-height: 1.55;
  }

  .room .h2,
  .artists .h2 {
    margin-bottom: 24px;
  }
  .room-container {
    container-type: inline-size;
  }
  .room-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr));
    grid-auto-rows: minmax(160px, 20vw);
    grid-auto-flow: dense;
    gap: 10px;
  }
  .room-grid figure {
    margin: 0;
    position: relative;
    overflow: hidden;
    background: var(--placeholder);
  }
  /* Emphasis spans only when the gallery is wide enough to hold them. */
  @container (min-width: 460px) {
    .room-grid .tall {
      grid-row: span 2;
    }
    .room-grid .wide {
      grid-column: span 2;
    }
  }
  .room-grid img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .room-grid figcaption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 22px 12px 10px;
    background: linear-gradient(transparent, rgba(43, 37, 33, 0.7));
    color: var(--paper);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.3;
  }
  /* Pointer devices reveal captions on hover; touch devices always show them. */
  @media (hover: hover) {
    .room-grid figcaption {
      opacity: 0;
      transition: opacity 0.25s ease;
    }
    .room-grid figure:hover figcaption,
    .room-grid figure:focus-within figcaption {
      opacity: 1;
    }
  }

  .artist-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 150px), 1fr));
    gap: var(--gap-tight);
  }
  .artist {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .artist:hover {
    color: var(--ink);
  }
  .square {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--placeholder);
  }
  .square img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .name {
    font-weight: 700;
    font-size: 15px;
    line-height: 1.2;
  }
  .medium {
    margin-top: 2px;
  }

  .prev-next {
    padding: 28px var(--pad-x);
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    font-size: 15px;
    font-weight: 700;
  }
</style>
