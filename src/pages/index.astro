---
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Statement from '../components/Statement.astro';
import ArtistGrid from '../components/ArtistGrid.astro';
import PastShows from '../components/PastShows.astro';
import { getEventsByStatus } from '../lib/events';

const settings = (await getEntry('site', 'settings'))!.data;
const artists = (await getCollection('artists')).sort((a, b) => a.data.order - b.data.order);
const { upcoming, past } = await getEventsByStatus();

// The hero card shows the next upcoming show, or falls back to the latest past show.
const featured = upcoming[0] ?? past[0];
const featuredIsUpcoming = upcoming.length > 0;
const latestPast = past[0];
---

<Base>
  <Hero hero={settings.home.hero} show={featured} showIsUpcoming={featuredIsUpcoming} />
  <Statement lead={settings.home.lead} sub={settings.home.sub} />
  <ArtistGrid artists={artists} />
  {latestPast && <PastShows show={latestPast} />}
</Base>
