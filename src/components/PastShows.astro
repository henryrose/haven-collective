---
import EventMosaic from './EventMosaic.astro';
import { formatDateRange, shortAddress, type EventEntry } from '../lib/events';
import { paragraphs } from '../lib/text';

interface Props {
  show: EventEntry;
}

const { show } = Astro.props;
const blurb = paragraphs(show.body).at(-1) ?? '';
---

<section class="section">
  <div class="section-head">
    <h2 class="h2">Past shows</h2>
    <a href="/events" class="text-link">Archive →</a>
  </div>
  <div class="container">
    <a href={`/events/${show.id}`} class="feature">
      <EventMosaic event={show} class="mosaic" />
      <div class="card">
        <div class="label date">{formatDateRange(show.data.startDate, show.data.endDate)}</div>
        <div class="title">{show.data.title}</div>
        <div class="venue">{show.data.venue} · {shortAddress(show.data.address)}</div>
        <p class="blurb">{blurb}</p>
        <span class="text-link see">See the show →</span>
      </div>
    </a>
  </div>
</section>

<style>
  .container {
    container-type: inline-size;
  }
  .feature {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: var(--gap);
    align-items: end;
  }
  .feature:hover {
    color: var(--ink);
  }
  /* At six-column widths the mosaic takes two of the three columns. */
  @container (min-width: 760px) {
    .mosaic {
      grid-column: span 2;
    }
  }
  .card {
    background: var(--paper);
    padding: 22px 24px 24px;
    box-shadow: 0 14px 30px -18px rgba(43, 37, 33, 0.4);
  }
  .date {
    color: var(--muted);
  }
  .title {
    font-size: clamp(26px, 3vw, 34px);
    font-weight: 800;
    line-height: 1.05;
    margin: 8px 0 6px;
    letter-spacing: -0.01em;
  }
  .venue {
    font-size: 16px;
    color: var(--muted);
  }
  .blurb {
    margin-top: 14px;
    font-size: 15px;
    line-height: 1.5;
  }
  .see {
    display: inline-block;
    margin-top: 14px;
    font-size: 14px;
  }
</style>
