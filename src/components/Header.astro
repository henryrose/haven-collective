---
import { url } from '../lib/url';
import type { CollectionEntry } from 'astro:content';

interface Props {
  settings: CollectionEntry<'site'>['data'];
  currentPath: string;
}

const { settings, currentPath } = Astro.props;
const nav = [
  { href: '/artists', label: 'Artists' },
  { href: '/events', label: 'Events' },
  { href: '/about', label: 'About' },
];
const isActive = (href: string) => currentPath === url(href) || currentPath.startsWith(url(href) + '/');
---

<header class="site-header">
  <a href={url('/')} class="brand">
    <span class="wordmark">{settings.name}</span>
    <span class="location">{settings.location}</span>
  </a>
  <nav aria-label="Primary">
    {
      nav.map((item) => (
        <a href={url(item.href)} class:list={{ active: isActive(item.href) }} aria-current={isActive(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))
    }
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding: 22px var(--pad-x);
    border-bottom: 1px solid var(--hairline);
    flex-wrap: wrap;
  }
  .brand {
    display: flex;
    align-items: baseline;
    gap: 14px;
  }
  .brand:hover {
    color: var(--ink);
  }
  .wordmark {
    font-weight: 800;
    font-size: 19px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .location {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }
  nav {
    display: flex;
    gap: 28px;
    font-size: 15px;
    font-weight: 500;
  }
  nav a.active {
    border-bottom: 1.5px solid var(--clay);
    padding-bottom: 2px;
  }
</style>
