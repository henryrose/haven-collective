---
interface Props {
  lead: string;
  sub: string;
}

const { lead, sub } = Astro.props;
// A single *word* in the lead renders italic at weight 400 (e.g. "*still*").
const leadHtml = lead
  .replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[c]!)
  .replace(/\*([^*]+)\*/g, '<em>$1</em>');
---

<section class="section statement">
  <p class="lead" set:html={leadHtml} />
  <p class="sub">{sub}</p>
  <a href="/about" class="text-link">Read the collective statement</a>
</section>

<style>
  .statement {
    padding-block: var(--pad-statement);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .lead {
    max-width: 820px;
    font-size: clamp(24px, 3.2vw, 38px);
    line-height: 1.25;
    font-weight: 500;
  }
  .lead :global(em) {
    font-style: italic;
    font-weight: 400;
  }
  .sub {
    margin-top: 22px;
    max-width: 560px;
    font-size: 16px;
    line-height: 1.55;
    color: var(--muted);
  }
  .text-link {
    margin-top: 22px;
  }
</style>
