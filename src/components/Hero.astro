---
import { url } from '../lib/url';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { formatDateRange, shortAddress, type EventEntry } from '../lib/events';

interface Props {
  hero: CollectionEntry<'site'>['data']['home']['hero'];
  show: EventEntry | undefined;
  showIsUpcoming: boolean;
}

const { hero, show, showIsUpcoming } = Astro.props;
const dateLine = show
  ? showIsUpcoming
    ? `Opens ${formatDateRange(show.data.startDate, show.data.endDate)}`
    : formatDateRange(show.data.startDate, show.data.endDate)
  : '';
const venueLine = show ? `${show.data.venue} · ${shortAddress(show.data.address)}` : '';
---

<section class="hero" data-hero>
  <div class="layer" data-hero-layer>
    <Image
      src={hero.image}
      alt=""
      widths={[640, 960, 1280, 1400]}
      sizes="100vw"
      priority
      style={`object-position: ${hero.position}`}
    />
  </div>

  {
    show && (
      <div class="card">
        <div class="eyebrow label" class:list={{ muted: !showIsUpcoming }}>
          <span class="dot" />
          {showIsUpcoming ? 'Upcoming show' : 'Latest show'}
        </div>
        <h1>{show.data.title}</h1>
        <div class="details">
          {dateLine}
          <br />
          <span class="venue">{venueLine}</span>
        </div>
        <a href={url(`/events/${show.id}`)} class="button">
          Show details →
        </a>
      </div>
    )
  }

  <div class="caption">{hero.caption}</div>
</section>

<script>
  // Scroll parallax: the image layer is 18% taller than the hero and moves at 0.35× scroll.
  // Disabled when the visitor prefers reduced motion.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const layer = document.querySelector<HTMLElement>('[data-hero-layer]');

  if (hero && layer && !reduce.matches) {
    let raf = 0;
    const update = () => {
      raf = 0;
      const y = window.scrollY || document.documentElement.scrollTop || 0;
      layer.style.transform = `translateY(${Math.round(y * 0.35)}px)`;
    };
    const onScroll = () => {
      if (!raf) raf = requestAnimationFrame(update);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    update();
  }
</script>

<style>
  .hero {
    position: relative;
    height: clamp(440px, 66vh, 680px);
    overflow: hidden;
    border-bottom: 1px solid var(--hairline);
    background: var(--placeholder);
  }
  .layer {
    position: absolute;
    inset: -18% 0;
    will-change: transform;
  }
  .layer img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (prefers-reduced-motion: reduce) {
    .layer {
      inset: 0;
      will-change: auto;
    }
  }

  .card {
    position: absolute;
    left: var(--pad-x);
    bottom: clamp(20px, 4vw, 48px);
    max-width: min(440px, calc(100% - 40px));
    background: var(--paper);
    padding: 22px 26px 24px;
    box-shadow: var(--shadow-card);
  }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--clay);
  }
  .eyebrow.muted {
    color: var(--muted);
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: currentColor;
  }
  h1 {
    margin: 10px 0 6px;
    font-size: clamp(32px, 4vw, 44px);
    line-height: 1;
    font-weight: 800;
    letter-spacing: -0.01em;
  }
  .details {
    font-size: 17px;
    line-height: 1.4;
  }
  .venue {
    color: var(--muted);
  }
  .card .button {
    margin-top: 16px;
  }

  .caption {
    position: absolute;
    right: var(--pad-x);
    top: 18px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--paper);
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.6);
    max-width: 220px;
    text-align: right;
    line-height: 1.4;
  }
</style>
